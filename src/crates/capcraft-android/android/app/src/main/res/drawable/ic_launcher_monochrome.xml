<?xml version="1.0" encoding="utf-8"?>
<!-- CapCraft Forge's icon in one colour, for themed icons: the CF and its spark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- drawn on a 108 grid, then scaled 0.86 about (55,54) and moved 1 left, to sit in the 66dp safe zone -->
    <group
        android:pivotX="55"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86"
        android:translateX="-1">
        <!-- the C, its top running on into the F's top bar -->
        <path
            android:pathData="M78,36 L46,36 A18,18 0 0,0 46,72 L56,72"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="9" />
        <!-- the F's stem and middle bar -->
        <path
            android:pathData="M66,36 V76.5"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="9" />
        <path
            android:pathData="M66,55 H77"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8" />
        <!-- the spark struck off the F -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M87,48 Q87,55 94,55 Q87,55 87,62 Q87,55 80,55 Q87,55 87,48 Z" />
    </group>
</vector>
