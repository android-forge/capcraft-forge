<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="5dp">

    <TextView
        android:id="@+id/widget_new"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_new"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_photo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_photo"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_shoot"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_shoot"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_record"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_record"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

</LinearLayout>
